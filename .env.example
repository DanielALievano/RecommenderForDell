# Session store: memory | redis
STORE_BACKEND=memory
SESSION_TTL_SECONDS=1800

# Redis (only when STORE_BACKEND=redis)
REDIS_URL=redis://localhost:6379/0
REDIS_TLS=false

# GenAI / LLM endpoint (OpenAI-compatible)
GENAI_API_URL=https://your-genai-endpoint/v1
OPENSOURCE_LLM_KEY=your-llm-api-key-here
GENAI_LLM_MODEL=your-model-name-here
EMBEDDING_MODEL=embeddinggemma-300m
EMBEDDING_DIMS=768

# Pipeline tuning
VECTOR_EMA_ALPHA=0.30
COSINE_DELTA_THRESHOLD=0.20
RECENT_RAW_CHUNKS=5
PUSH_MIN_CONFIDENCE=0.70

# Discovery: mock | live
DISCOVERY_MODE=mock
DISCOVERY_API_URL=https://your-discovery-endpoint
DISCOVERY_API_KEY=your-discovery-key-here

# App
LOG_LEVEL=INFO
